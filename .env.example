# Amazon Lex V2 chatbot configuration.
# These values are read server-side by the Next.js API route.
AWS_REGION=us-east-1
LEX_BOT_ID=
LEX_BOT_ALIAS_ID=
LEX_LOCALE_ID=en_US
AWS_LEX_READ_ROLE=

# Local development only, if you are not using an AWS profile or deployment IAM role.
# Never expose these through NEXT_PUBLIC_* variables.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
